{
  "name": "@renaiss/replay-fair-set",
  "version": "0.1.0",
  "description": "The fair-set replay layer — the seed derivation that commits a build to public inputs, and the retry/record loop that replays a whole VRF-seeded set formation attempt by attempt.",
  "keywords": [
    "gacha",
    "set-building",
    "deterministic",
    "vrf",
    "replay",
    "verification"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Renaiss-Protocol/renaiss-fair.git",
    "directory": "packages/replay-fair-set"
  },
  "homepage": "https://github.com/Renaiss-Protocol/renaiss-fair/tree/main/packages/replay-fair-set#readme",
  "bugs": "https://github.com/Renaiss-Protocol/renaiss-fair/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "c8 --reporter=text --reporter=html node --import tsx --test \"src/**/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@renaiss/algorithms": "workspace:*",
    "viem": "^2.50.4"
  },
  "devDependencies": {
    "@renaiss/ecvrf": "workspace:*",
    "@types/node": "^24.0.0",
    "c8": "^10.1.3",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
