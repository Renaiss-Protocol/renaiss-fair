{
  "name": "@renaiss/verifiable-draw",
  "version": "0.1.0",
  "description": "The verifiable draw pipeline over @renaiss/ecvrf — hex API, β→stream expansion, prove/verify-and-expand, and the draw-resolution seed and index derivations.",
  "keywords": [
    "vrf",
    "ecvrf",
    "rfc9381",
    "verifiable-randomness",
    "provably-fair",
    "draw",
    "lottery"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Renaiss-Protocol/renaiss-fair.git",
    "directory": "packages/verifiable-draw"
  },
  "homepage": "https://github.com/Renaiss-Protocol/renaiss-fair/tree/main/packages/verifiable-draw#readme",
  "bugs": "https://github.com/Renaiss-Protocol/renaiss-fair/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "c8 --reporter=text --reporter=html node --import tsx --test \"src/**/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@renaiss/ecvrf": "workspace:*",
    "viem": "^2.50.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "c8": "^10.1.3",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
