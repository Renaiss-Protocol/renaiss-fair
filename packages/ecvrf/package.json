{
  "name": "@renaiss/ecvrf",
  "version": "0.1.0",
  "description": "RFC 9381 ECVRF-EDWARDS25519-SHA512-ELL2 verifiable random function — a spec-faithful, dependency-light implementation validated against the official Appendix B.4 test vectors.",
  "keywords": [
    "vrf",
    "ecvrf",
    "rfc9381",
    "rfc-9381",
    "edwards25519",
    "ed25519",
    "verifiable-random-function",
    "cryptography"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Renaiss-Protocol/renaiss-fair.git",
    "directory": "packages/ecvrf"
  },
  "homepage": "https://github.com/Renaiss-Protocol/renaiss-fair/tree/main/packages/ecvrf#readme",
  "bugs": "https://github.com/Renaiss-Protocol/renaiss-fair/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "c8 --reporter=text --reporter=html node --import tsx --test \"src/**/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "c8": "^10.1.3",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
