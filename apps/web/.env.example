# All variables are NEXT_PUBLIC_* — inlined at build time (static export),
# so changing any of them requires a rebuild. Copy to .env.local to use.

# Renaiss API host — bare host only, no path (route prefixes like /v0/fair
# live in lib/api/renaiss). Set ⇒ Sets / Packing / Prove-it fetch production
# data from this host.
# Unset ⇒ lib/api/client.ts serves the committed demo fixtures (default).
# NEXT_PUBLIC_RENAISS_API_URL=

# On-chain root reads (API mode) — the Sets tab's "published root" chip
# compares the browser-recomputed root against
# the vending-machine contract's merkleRoots(onChainPackId, setId) read from the
# chain (the actual commitment). Both must be set; otherwise the chip falls
# back to the API-served root, labeled as such.
# NEXT_PUBLIC_RPC_URL=https://…
# NEXT_PUBLIC_TVM_ADDRESS=0x…

# Token explorer links — every token id links to
# {EXPLORER_URL}/nft/{NFT_ADDRESS}/{decimalTokenId}. NFT_ADDRESS is the
# RenaissRegistry (the NFT collection), NOT the vending machine the verify
# API serves. Unset ⇒ chapel/BSC-testnet defaults in lib/config.ts.
# NEXT_PUBLIC_NFT_ADDRESS=
# NEXT_PUBLIC_EXPLORER_URL=

# Exploratory visualization routes — unset ⇒ 404 + hidden from nav.
# NEXT_PUBLIC_SHOW_FLOW=1
# NEXT_PUBLIC_SHOW_STORY=1
# NEXT_PUBLIC_SHOW_TAMPER=1
# NEXT_PUBLIC_SHOW_DESIGN_CONFIG=1   # whitepaper palette switcher
