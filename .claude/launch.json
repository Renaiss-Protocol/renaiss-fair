{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-export",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3100",
        "--directory",
        "apps/web/out",
        "--bind",
        "0.0.0.0"
      ],
      "port": 3100
    }
  ]
}
